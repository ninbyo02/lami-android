<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application android:extractNativeLibs="true">
        <activity android:name="io.github.ninbyo02.lami.npu.NpuReferenceChatSetupActivity" android:exported="true" />
        <activity android:name="io.github.ninbyo02.lami.remote.EmulatorCpuReferenceActivity" android:exported="true" android:label="LAMI CPU Reference (Debug)" />
        <activity
            android:name=".tts.ResidentCpContextProbeActivity"
            android:process=":cp_context_probe"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <activity
            android:name=".tts.ResidentCpSingleStepProbeActivity"
            android:process=":cp_single_step_probe"
            android:permission="android.permission.DUMP"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <activity
            android:name=".tts.ResidentCpLibraryProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true" />

        <activity
            android:name=".assistant.BluetoothAssistSetupActivity"
            android:exported="true"
            android:label="Bluetooth待機"
            android:theme="@style/Theme.Ollama" />
        <activity
            android:name=".assistant.BluetoothMicSetupActivity"
            android:exported="false"
            android:label="Bluetoothマイク確認"
            android:theme="@style/Theme.Ollama" />
        <service
            android:name=".assistant.BluetoothAssistStandbyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="debug_opt_in_bluetooth_assistant_standby_up_to_60_minutes_no_recording" />
        </service>
        <service
            android:name=".assistant.JabraUsbButtonService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <activity
            android:name=".assistant.JabraUsbSetupActivity"
            android:exported="true"
            android:label="Jabra USB"
            android:theme="@style/Theme.Ollama" />
        <service
            android:name=".assistant.JabraAssistKeyService"
            android:exported="true"
            android:label="@string/jabra_assist_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/jabra_assist_key_service" />
        </service>
        <service
            android:name="io.github.ninbyo02.lami.integration.CpuBackgroundIntegrationService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:process=":cpu_integration"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="debug_cpu_background_integration_test" />
        </service>
        <service
            android:name="io.github.ninbyo02.lami.integration.GenerationIntegrationTestService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="debug_background_generation_integration_test" />
        </service>
        <service
            android:name="io.github.ninbyo02.lami.gpu.LiteRtLmGpuBenchmarkService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="debug_litert_lm_benchmark" />
        </service>
        <activity
            android:name="io.github.ninbyo02.lami.gpu.DebugTokenBenchmarkActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Ollama" />
        <activity
            android:name="io.github.ninbyo02.lami.debug.LiteRtModelInspectorActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="io.github.ninbyo02.lami.debug.LiteRtMinimalSmokeTestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="io.github.ninbyo02.lami.debug.QairtNpuProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:process=":qairt_npu_probe"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="io.github.ninbyo02.lami.debug.QnnDirectProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:process=":qnn_direct_probe"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="io.github.ninbyo02.lami.ui.screens.home.Qairt244DevOnlyNpuConversationActivity"
            android:excludeFromRecents="true"
            android:exported="true" />

        <activity
            android:name="io.github.ninbyo02.lami.npu.NpuKotlinConversationDurabilityActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name="io.github.ninbyo02.lami.remote.RemoteStreamingProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ninbyo02.lami.action.REMOTE_STREAMING_PROBE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="io.github.ninbyo02.lami.npu.DevOnlyNpuOneTurnConversationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ninbyo02.lami.action.DEV_ONLY_NPU_ONE_TURN_CONVERSATION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="io.github.ninbyo02.lami.npu.NpuKotlinConversationDurabilityReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ninbyo02.lami.action.NPU_KOTLIN_CONVERSATION_DURABILITY" />
            </intent-filter>
        </receiver>

        <service
            android:name="io.github.ninbyo02.lami.debug.QairtNpuProbeService"
            android:exported="true"
            android:process=":qairt_npu_probe" />
        <activity
            android:name="io.github.ninbyo02.lami.tts.LamiNeuralVoiceDiagnosticActivity"
            android:exported="true"
            android:theme="@style/Theme.Ollama" />
        <service
            android:name="io.github.ninbyo02.lami.tts.LamiNeuralVoiceDiagnosticService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="debug_bounded_on_device_voice_generation" />
        </service>
        <service
            android:name="io.github.ninbyo02.lami.tts.LamiVoiceDecoderService"
            android:exported="false"
            android:process=":voice_decoder" />
    </application>
</manifest>
