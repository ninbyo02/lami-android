+std::string TensorBufferShapeForDiagnostics(const TensorBuffer& buffer) {
+  auto tensor_type = buffer.TensorType();
+  if (!tensor_type) {
+    return absl::StrCat("shape_unavailable:", tensor_type.Error().Message());
+  }
+  const auto& dims = tensor_type->Layout().Dimensions();
+  return absl::StrCat("[", absl::StrJoin(dims, ","), "]");
+}
+
+std::string TensorBufferByteSizeForDiagnostics(const TensorBuffer& buffer) {
+  auto packed_size = buffer.PackedSize();
+  if (!packed_size) {
+    return absl::StrCat("bytes_unavailable:", packed_size.Error().Message());
+  }
+  return absl::StrCat(*packed_size);
+}
+
+std::string TensorBufferElementTypeForDiagnostics(const TensorBuffer& buffer) {
+  auto tensor_type = buffer.TensorType();
+  if (!tensor_type) {
+    return absl::StrCat("type_unavailable:", tensor_type.Error().Message());
+  }
+  return absl::StrCat(tensor_type->ElementType());
+}
+
+std::string TensorBufferMapForDiagnostics(
+    const absl::flat_hash_map<absl::string_view, TensorBuffer>& buffers) {
+  std::vector<std::string> entries;
+  entries.reserve(buffers.size());
+  for (const auto& [name, buffer] : buffers) {
+    entries.push_back(absl::StrCat(
+        name, ":shape=", TensorBufferShapeForDiagnostics(buffer),
+        ":bytes=", TensorBufferByteSizeForDiagnostics(buffer),
+        ":type=", TensorBufferElementTypeForDiagnostics(buffer)));
+  }
+  std::sort(entries.begin(), entries.end());
+  return absl::StrJoin(entries, "|");
+}
+
+std::string DiagnosticIntOrUnavailable(int value) {
+  return value >= 0 ? absl::StrCat(value) : "unavailable";
+}
 
