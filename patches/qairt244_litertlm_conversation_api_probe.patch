+LITERTLM_JNIEXPORT jstring JNICALL
+Java_io_github_ninbyo02_lami_ui_screens_home_Qairt244ShortMultitokenSmoke_nativeRunConversationApiProbe(
+    JNIEnv* env, jclass thiz, jstring model_path,
+    jstring native_library_dir, jstring cache_dir, jstring result_path,
+    jstring diag_path, jstring system_instruction, jstring prompts_json,
+    jint max_output_tokens) {
+  const absl::Time probe_start_time = absl::Now();
+  std::string model_path_str;
+  std::string native_library_dir_str;
+  std::string cache_dir_str;
+  std::string result_path_str;
+  std::string diag_path_str;
+  std::string system_instruction_str;
+  std::string prompts_json_str;
+  std::string status = "running";
+  std::string failure_stage = "unavailable";
+  std::string failure_reason = "unavailable";
+  std::string last_stage = "entrypoint";
+  bool model_assets_created = false;
+  bool engine_settings_created = false;
+  bool engine_created = false;
+  bool conversation_config_created = false;
+  bool conversation_created = false;
+  bool conversation_closed = false;
+  bool engine_closed = false;
+  int send_attempt_count = 0;
+  int send_success_count = 0;
+  std::vector<std::string> detail_lines;
+
+  GetOptionalJString(env, diag_path, &diag_path_str, nullptr, "diag_path",
+                     kQairt244ConversationApiProbeMarker);
+
+  auto append_stage_diag = [&](const std::string& stage) {
+    last_stage = stage;
+    AppendQairt244Diag(diag_path_str.c_str(), "%s stage=%s",
+                       kQairt244ConversationApiProbeMarker, stage.c_str());
+  };
+
+  auto write_result = [&]() {
+    std::vector<std::string> lines;
+    lines.push_back("marker=" +
+                    std::string(kQairt244ConversationApiProbeMarker));
+    lines.push_back("status=" + status);
+    lines.push_back("last_stage=" + last_stage);
+    lines.push_back("failure_stage=" + failure_stage);
+    lines.push_back("failure_reason=" +
+                    Qairt244FlattenValue(failure_reason));
+    lines.push_back("backend=NPU");
+    lines.push_back("conversation_api_used=true");
+    lines.push_back("conversation_api_surface=C++");
+    lines.push_back("direct_session_api_used=false");
+    lines.push_back("direct_run_prefill_used=false");
+    lines.push_back("direct_run_decode_used=false");
+    lines.push_back("app_template_used=false");
+    lines.push_back("overwrite_prompt_template_used=false");
+    lines.push_back("model_template_source=model_metadata");
+    lines.push_back("template_ownership_unified_candidate=true");
+    lines.push_back("model_assets_created=" +
+                    std::string(model_assets_created ? "true" : "false"));
+    lines.push_back("engine_settings_created=" +
+                    std::string(engine_settings_created ? "true" : "false"));
+    lines.push_back("engine_created=" +
+                    std::string(engine_created ? "true" : "false"));
+    lines.push_back("conversation_config_created=" +
+                    std::string(conversation_config_created ? "true"
+                                                            : "false"));
+    lines.push_back("conversation_created=" +
+                    std::string(conversation_created ? "true" : "false"));
+    lines.push_back("conversation_closed=" +
+                    std::string(conversation_closed ? "true" : "false"));
+    lines.push_back("engine_closed=" +
+                    std::string(engine_closed ? "true" : "false"));
+    lines.push_back("send_attempt_count=" +
+                    std::to_string(send_attempt_count));
+    lines.push_back("send_success_count=" +
+                    std::to_string(send_success_count));
+    lines.push_back("requested_max_output_tokens=" +
+                    std::to_string(max_output_tokens));
+    lines.push_back("sampler_config_profile=lami_stable_v1");
+    lines.push_back("sampler_backend=NPU");
+    lines.push_back("sampler_top_k=40");
+    lines.push_back("sampler_top_p=0.9");
+    lines.push_back("sampler_temperature=0.3");
+    lines.push_back("sampler_seed=42");
+    lines.push_back("backend_evidence=QNN_HTP_V79_FastRPC_native_diag_conversation_api_candidate");
+    lines.push_back("probe_elapsed_ms=" +
+                    std::to_string(absl::ToInt64Milliseconds(
+                        absl::Now() - probe_start_time)));
+    lines.push_back("details_begin=true");
+    lines.insert(lines.end(), detail_lines.begin(), detail_lines.end());
+    WriteQairt244PersistentProbeResult(result_path_str, lines);
+  };
+
+  auto fail = [&](const std::string& stage, const std::string& reason) {
+    status = "failure";
+    failure_stage = stage;
+    failure_reason = reason;
+    append_stage_diag(stage + " failure=" + reason);
+    write_result();
+  };
+
+  if (!GetOptionalJString(env, model_path, &model_path_str,
+                          diag_path_str.c_str(), "model_path",
+                          kQairt244ConversationApiProbeMarker) ||
+      !GetOptionalJString(env, native_library_dir, &native_library_dir_str,
+                          diag_path_str.c_str(), "native_library_dir",
+                          kQairt244ConversationApiProbeMarker) ||
+      !GetOptionalJString(env, cache_dir, &cache_dir_str,
+                          diag_path_str.c_str(), "cache_dir",
+                          kQairt244ConversationApiProbeMarker) ||
+      !GetOptionalJString(env, result_path, &result_path_str,
+                          diag_path_str.c_str(), "result_path",
+                          kQairt244ConversationApiProbeMarker) ||
+      !GetOptionalJString(env, system_instruction, &system_instruction_str,
+                          diag_path_str.c_str(), "system_instruction",
+                          kQairt244ConversationApiProbeMarker) ||
+      !GetOptionalJString(env, prompts_json, &prompts_json_str,
+                          diag_path_str.c_str(), "prompts_json",
+                          kQairt244ConversationApiProbeMarker)) {
+    fail("jni_string", "jni-string-conversion-failed");
+    ThrowLiteRtLmJniException(
+        env, "QAIRT Conversation API probe string conversion failed");
+    return nullptr;
+  }
+  if (model_path_str.empty() || native_library_dir_str.empty() ||
+      result_path_str.empty()) {
+    fail("argument", "missing-required-path");
+    ThrowLiteRtLmJniException(
+        env, "QAIRT Conversation API probe missing required path");
+    return nullptr;
+  }
+  if (!FileExists(model_path_str)) {
+    fail("model_assets", "model-file-not-found");
+    ThrowLiteRtLmJniException(env, "Model file not found: " + model_path_str);
+    return nullptr;
+  }
+  if (max_output_tokens < 1 || max_output_tokens > 128) {
+    fail("argument", "invalid-max-output-tokens");
+    ThrowLiteRtLmJniException(
+        env, "Conversation API probe max_output_tokens must be 1..128");
+    return nullptr;
+  }
+
+  auto prompts =
+      nlohmann::ordered_json::parse(prompts_json_str, nullptr, false);
+  if (prompts.is_discarded() || !prompts.is_array() || prompts.empty() ||
+      prompts.size() > 11) {
+    fail("argument", "prompts-json-must-be-array-with-1-to-11-items");
+    ThrowLiteRtLmJniException(
+        env, "Conversation API probe prompts_json must contain 1..11 items");
+    return nullptr;
+  }
+  for (const auto& prompt_item : prompts) {
+    if (!prompt_item.is_string() || prompt_item.get<std::string>().empty()) {
+      fail("argument", "prompt-must-be-non-empty-string");
+      ThrowLiteRtLmJniException(
+          env, "Conversation API probe prompt must be a non-empty string");
+      return nullptr;
+    }
+  }
+
+  append_stage_diag("before_model_assets_create");
+  auto model_assets = ModelAssets::Create(model_path_str);
+  if (!model_assets.ok()) {
+    const std::string reason =
+        "model-assets-failed:" + model_assets.status().ToString();
+    fail("model_assets", reason);
+    ThrowLiteRtLmJniException(env, reason);
+    return nullptr;
+  }
+  model_assets_created = true;
+  write_result();
+
+  auto backend_enum = litert::lm::GetBackendFromString("NPU");
+  if (!backend_enum.ok()) {
+    const std::string reason =
+        "backend-npu-failed:" + backend_enum.status().ToString();
+    fail("backend", reason);
+    ThrowLiteRtLmJniException(env, reason);
+    return nullptr;
+  }
+
+  append_stage_diag("before_engine_settings_create");
+  auto settings = EngineSettings::CreateDefault(*model_assets, *backend_enum);
+  if (!settings.ok()) {
+    const std::string reason =
+        "engine-settings-failed:" + settings.status().ToString();
+    fail("engine_settings", reason);
+    ThrowLiteRtLmJniException(env, reason);
+    return nullptr;
+  }
+  engine_settings_created = true;
+  if (!cache_dir_str.empty()) {
+    settings->GetMutableMainExecutorSettings().SetCacheDir(cache_dir_str);
+  }
+  settings->GetMutableMainExecutorSettings().SetLitertDispatchLibDir(
+      native_library_dir_str);
+  write_result();
+
+  append_stage_diag("before_engine_create");
+  auto engine = EngineFactory::CreateDefault(*settings);
+  if (!engine.ok()) {
+    const std::string reason =
+        "engine-create-failed:" + engine.status().ToString();
+    fail("engine_create", reason);
+    ThrowLiteRtLmJniException(env, reason);
+    return nullptr;
+  }
+  std::unique_ptr<Engine> engine_ptr = std::move(*engine);
+  engine_created = true;
+  write_result();
+
+  auto session_config = SessionConfig::CreateDefault();
+  session_config.SetSamplerBackend(Backend::NPU);
+  auto& sampler_params = session_config.GetMutableSamplerParams();
+  sampler_params.set_type(SamplerParameters::TOP_P);
+  sampler_params.set_k(40);
+  sampler_params.set_p(0.9f);
+  sampler_params.set_temperature(0.3f);
+  sampler_params.set_seed(42);
+
+  JsonPreface json_preface;
+  json_preface.messages = nlohmann::ordered_json::array();
+  json_preface.tools = nlohmann::ordered_json::array();
+  json_preface.extra_context = nlohmann::ordered_json::object();
+  if (!system_instruction_str.empty()) {
+    nlohmann::ordered_json system_content = nlohmann::ordered_json::array();
+    system_content.push_back(
+        {{"type", "text"}, {"text", system_instruction_str}});
+    json_preface.messages.push_back(
+        {{"role", "system"}, {"content", system_content}});
+  }
+
+  append_stage_diag("before_conversation_config_create");
+  auto conversation_config =
+      ConversationConfig::Builder()
+          .SetSessionConfig(session_config)
+          .SetPreface(json_preface)
+          .Build(*engine_ptr);
+  if (!conversation_config.ok()) {
+    const std::string reason =
+        "conversation-config-failed:" +
+        conversation_config.status().ToString();
+    fail("conversation_config", reason);
+    engine_ptr.reset();
+    engine_closed = true;
+    write_result();
+    ThrowLiteRtLmJniException(env, reason);
+    return nullptr;
+  }
+  conversation_config_created = true;
+  write_result();
+
+  append_stage_diag("before_conversation_create");
+  auto conversation =
+      Conversation::Create(*engine_ptr, *conversation_config);
+  if (!conversation.ok()) {
+    const std::string reason =
+        "conversation-create-failed:" + conversation.status().ToString();
+    fail("conversation_create", reason);
+    engine_ptr.reset();
+    engine_closed = true;
+    write_result();
+    ThrowLiteRtLmJniException(env, reason);
+    return nullptr;
+  }
+  std::unique_ptr<Conversation> conversation_ptr = std::move(*conversation);
+  conversation_created = true;
+  write_result();
+
+  int turn_index = 0;
+  for (const auto& prompt_item : prompts) {
+    turn_index += 1;
+    const std::string prompt_text = prompt_item.get<std::string>();
+    nlohmann::ordered_json content = nlohmann::ordered_json::array();
+    content.push_back({{"type", "text"}, {"text", prompt_text}});
+    Message user_message =
+        nlohmann::ordered_json::object(
+            {{"role", "user"}, {"content", content}});
+    litert::lm::OptionalArgs optional_args;
+    optional_args.max_output_tokens = max_output_tokens;
+    send_attempt_count += 1;
+    append_stage_diag("turn_" + std::to_string(turn_index) +
+                      "_before_send_message");
+    const absl::Time send_start = absl::Now();
+    auto response =
+        conversation_ptr->SendMessage(user_message, std::move(optional_args));
+    const long send_ms =
+        absl::ToInt64Milliseconds(absl::Now() - send_start);
+    if (!response.ok()) {
+      const std::string reason =
+          "send-message-failed:" + response.status().ToString();
+      detail_lines.push_back("turn_index=" + std::to_string(turn_index));
+      detail_lines.push_back("user_prompt=" +
+                             Qairt244FlattenValue(prompt_text));
+      detail_lines.push_back("turn_status=failure");
+      detail_lines.push_back("turn_reason=" +
+                             Qairt244FlattenValue(reason));
+      detail_lines.push_back("send_ms=" + std::to_string(send_ms));
+      fail("send_message", reason);
+      break;
+    }
+
+    send_success_count += 1;
+    std::string output;
+    if (response->contains("content") &&
+        (*response)["content"].is_array()) {
+      for (const auto& part : (*response)["content"]) {
+        if (part.is_object() && part.value("type", "") == "text" &&
+            part.contains("text") && part["text"].is_string()) {
+          output += part["text"].get<std::string>();
+        }
+      }
+    }
+    detail_lines.push_back("turn_index=" + std::to_string(turn_index));
+    detail_lines.push_back("user_prompt=" +
+                           Qairt244FlattenValue(prompt_text));
+    detail_lines.push_back("turn_status=success");
+    detail_lines.push_back("turn_reason=completed");
+    detail_lines.push_back("raw_output=" +
+                           Qairt244FlattenValue(output));
+    detail_lines.push_back("response_json=" +
+                           Qairt244FlattenValue(response->dump()));
+    detail_lines.push_back("send_ms=" + std::to_string(send_ms));
+    write_result();
+  }
+
+  conversation_ptr.reset();
+  conversation_closed = true;
+  engine_ptr.reset();
+  engine_closed = true;
+  if (failure_stage == "unavailable" &&
+      send_success_count == static_cast<int>(prompts.size())) {
+    status = "success";
+    append_stage_diag("completed");
+  }
+  write_result();
+  return NewStringStandardUTF(env, status);
+}
+
 LITERTLM_JNIEXPORT jstring JNICALL JNI_METHOD(nativeGenerateContent)(
     JNIEnv* env, jclass thiz, jlong session_pointer, jobjectArray input_data) {
   Engine::Session* session =
