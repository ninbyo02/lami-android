+void AppendQairt244Diag(const char* path, const char* format, ...) {
+  const char* target_path =
+      (path != nullptr && path[0] != '\0') ? path : kQairt244NativeDiagPath;
+  FILE* file = std::fopen(target_path, "a");
+  if (file == nullptr) {
+    return;
+  }
+  std::fprintf(file, "%s ", kQairt244NativeFileMarker);
+  va_list args;
+  va_start(args, format);
+  std::vfprintf(file, format, args);
+  va_end(args);
+  std::fprintf(file, "\n");
+  std::fflush(file);
+  std::fclose(file);
+}
+
+bool GetOptionalJString(JNIEnv* env, jstring value, std::string* out,
+                        const char* diag_path, const char* label,
+                        const char* marker =
+                            kQairt244LowerLevelSingleTokenMarker) {
+  if (out == nullptr) {
+    return false;
+  }
+  out->clear();
+  if (value == nullptr) {
+    AppendQairt244Diag(diag_path, "%s %s null", marker, label);
+    return true;
+  }
+  AppendQairt244Diag(diag_path, "%s before GetStringUTFChars label=%s",
+                     marker, label);
+  const char* chars = env->GetStringUTFChars(value, nullptr);
+  if (chars == nullptr) {
+    AppendQairt244Diag(diag_path,
+                       "%s GetStringUTFChars failed label=%s",
+                       marker, label);
+    return false;
+  }
+  *out = chars;
+  env->ReleaseStringUTFChars(value, chars);
+  AppendQairt244Diag(diag_path, "%s read string label=%s length=%zu",
+                     marker, label, out->size());
+  return true;
+}
