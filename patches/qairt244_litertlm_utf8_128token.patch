+void Qairt244SentinelLog(const char* format, ...) {
+  va_list args;
+  va_start(args, format);
+#if defined(__ANDROID__)
+  __android_log_vprint(ANDROID_LOG_ERROR, "QAIRT244_SENTINEL", format, args);
+#else
+  std::vfprintf(stderr, format, args);
+  std::fprintf(stderr, "\n");
+#endif
+  va_end(args);
+
+  va_start(args, format);
+  std::fprintf(stderr, "QAIRT244_SENTINEL: ");
+  std::vfprintf(stderr, format, args);
+  std::fprintf(stderr, "\n");
+  std::fflush(stderr);
+  va_end(args);
+}
