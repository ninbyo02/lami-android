+    append_stage_diag("ModelAssets::Create success");
+    write_result();
+    if (native_probe_mode_str == "model_assets_only") {
+      status = "completed";
+      hypothesis_result = "model_assets_only_success";
+      write_result();
+      append_stage_diag("model_assets_only completed");
+      return NewStringStandardUTF(env, status);
+    }
+
+    auto backend_enum = litert::lm::GetBackendFromString("NPU");
+    if (!backend_enum.ok()) {
+      const std::string detail =
+          "backend-npu-failed:" + backend_enum.status().ToString();
+      record_failure(0, "backend", detail, detail);
+      write_result();
+      ThrowLiteRtLmJniException(env, detail);
+      return nullptr;
+    }
+
+    engine_settings_create_reached = "true";
+    last_native_stage = "before_engine_settings_create";
+    append_stage_diag("before EngineSettings::CreateDefault");
+    write_result();
+    auto settings = EngineSettings::CreateDefault(*model_assets, *backend_enum);
+    if (!settings.ok()) {
+      const std::string detail =
+          "engine-settings-failed:" + settings.status().ToString();
+      record_failure(0, "engine_settings", detail, detail);
+      write_result();
+      ThrowLiteRtLmJniException(env, detail);
+      return nullptr;
+    }
+    engine_settings_create_returned = "true";
+    last_native_stage = "engine_settings_create_returned";
+    append_stage_diag("EngineSettings::CreateDefault success");
+    write_result();
+    if (native_probe_mode_str == "engine_settings_only") {
+      status = "completed";
+      hypothesis_result = "engine_settings_only_success";
+      write_result();
+      append_stage_diag("engine_settings_only completed");
+      return NewStringStandardUTF(env, status);
+    }
+    if (!cache_dir_str.empty()) {
+      settings->GetMutableMainExecutorSettings().SetCacheDir(cache_dir_str);
+    }
+    settings->GetMutableMainExecutorSettings().SetLitertDispatchLibDir(
+        native_library_dir_str);
+
+    last_native_stage = "before_engine_create";
+    append_stage_diag("before EngineFactory::CreateDefault mode=" +
+                      native_probe_mode_str + " signature=" +
+                      persistent_engine_create_signature);
+    if (native_probe_mode_str == "before_engine_create") {
+      status = "completed";
+      hypothesis_result = "before_engine_create_success";
+      write_result();
+      append_stage_diag("before_engine_create completed");
+      return NewStringStandardUTF(env, status);
+    }
+    engine_create_reached = "true";
+    write_result();
+    auto engine = EngineFactory::CreateDefault(*settings);
+    engine_create_count += 1;
+    if (!engine.ok()) {
+      const std::string detail =
+          "engine-create-failed:" + engine.status().ToString();
+      record_failure(0, "engine_create", detail, detail);
+      write_result();
+      ThrowLiteRtLmJniException(env, detail);
+      return nullptr;
+    }
+    engine_create_returned = "true";
+    last_native_stage = "engine_create_returned";
+    append_stage_diag("EngineFactory::CreateDefault success");
+    write_result();
+    if (native_probe_mode_str == "engine_create_only" ||
+        native_probe_mode_str == "editable_engine_create_only") {
+      std::unique_ptr<Engine> engine_ptr = std::move(*engine);
+      engine_close_reached = "true";
+      engine_ptr.reset();
+      engine_close_success = "true";
+      status = "completed";
+      hypothesis_result = native_probe_mode_str + "_success";
+      write_result();
+      append_stage_diag(native_probe_mode_str + " completed");
+      return NewStringStandardUTF(env, status);
+    }
+    g_qairt244_persistent_custom_jni_holder.engine = std::move(*engine);
+    g_qairt244_persistent_custom_jni_holder.holder_key = holder_key_str;
+    g_qairt244_persistent_custom_jni_holder.generation += 1;
+    g_qairt244_persistent_custom_jni_holder.reused_count = 0;
+    g_qairt244_persistent_custom_jni_holder.invalidated = false;
+    append_stage_diag(
+        "EngineFactory::CreateDefault success generation=" +
+        std::to_string(g_qairt244_persistent_custom_jni_holder.generation));
+  } else {
+    g_qairt244_persistent_custom_jni_holder.reused_count += 1;
+  }
+
+  Engine* engine_ptr = g_qairt244_persistent_custom_jni_holder.engine.get();
+  for (int run_index = 1; run_index <= requested_count; ++run_index) {
+    const absl::Time run_start = absl::Now();
+    std::string run_status = "success";
+    std::string run_reason = "completed";
+    std::string session_created = "false";
+    std::string session_closed = "false";
+    std::string prefill_started = "false";
+    std::string prefill_finished = "false";
+    std::string decode_started = "false";
+    std::string decode_finished = "false";
+    std::string output;
+    std::string native_diag_tail = "run_completed";
+    long prefill_ms = -1;
+    long decode_ms = -1;
+    long cleanup_ms = -1;
+
+    session_create_reached = "true";
+    last_native_stage = "before_session_create";
+    append_stage_diag("run=" + std::to_string(run_index) +
+                      " before CreateSession");
+    write_result();
+    auto session_config = SessionConfig::CreateDefault();
+    auto session = engine_ptr->CreateSession(session_config);
+    if (!session.ok()) {
+      run_status = "failure";
+      run_reason = "session-create-failed:" + session.status().ToString();
+      native_diag_tail = run_reason;
+      record_failure(run_index, "session_create", run_reason, native_diag_tail);
+    } else {
+      session_created = "true";
+      std::unique_ptr<Engine::Session> session_ptr = std::move(*session);
+      std::vector<InputData> inputs;
+      inputs.emplace_back(InputText(normalized_prompt.c_str()));
+      prefill_started = "true";
+      prefill_reached = "true";
+      last_native_stage = "before_prefill";
+      const absl::Time prefill_start = absl::Now();
+      append_stage_diag("run=" + std::to_string(run_index) +
+                        " before RunPrefill");
+      write_result();
+      auto prefill_status = session_ptr->RunPrefill(inputs);
+      prefill_ms = absl::ToInt64Milliseconds(absl::Now() - prefill_start);
+      if (!prefill_status.ok()) {
+        run_status = "failure";
+        run_reason = "prefill-failed:" + prefill_status.ToString();
+        native_diag_tail = run_reason;
+        record_failure(run_index, "prefill", run_reason, native_diag_tail);
+      } else {
+        prefill_finished = "true";
+        DecodeConfig decode_config = DecodeConfig::CreateDefault();
+        decode_config.SetMaxOutputTokens(max_output_tokens);
+        decode_started = "true";
+        decode_reached = "true";
+        last_native_stage = "before_decode";
+        decode_attempt_count += 1;
+        const absl::Time decode_start = absl::Now();
+        append_stage_diag("run=" + std::to_string(run_index) +
+                          " before RunDecode SetMaxOutputTokens(" +
+                          std::to_string(max_output_tokens) + ")");
+        write_result();
+        auto responses = session_ptr->RunDecode(decode_config);
+        decode_ms = absl::ToInt64Milliseconds(absl::Now() - decode_start);
+        if (!responses.ok()) {
+          run_status = "failure";
+          run_reason = "decode-failed:" + responses.status().ToString();
+          native_diag_tail = run_reason;
+          record_failure(run_index, "decode", run_reason, native_diag_tail);
+        } else {
+          decode_finished = "true";
+          decode_success_count += 1;
+          if (!responses->GetTexts().empty()) {
+            output = responses->GetTexts()[0];
+          }
+        }
+      }
+      const absl::Time cleanup_start = absl::Now();
+      session_ptr.reset();
+      session_closed = "true";
+      cleanup_ms = absl::ToInt64Milliseconds(absl::Now() - cleanup_start);
+    }
+
+    completed_count += 1;
+    if (run_status == "success") {
+      success_count += 1;
+      g_qairt244_persistent_custom_jni_holder.reused_count += 1;
+    }
+    const long total_ms =
+        absl::ToInt64Milliseconds(absl::Now() - run_start);
+    detail_lines.push_back("run_index=" + std::to_string(run_index));
+    detail_lines.push_back("status=" + run_status);
+    detail_lines.push_back("reason=" + Qairt244FlattenValue(run_reason));
+    detail_lines.push_back("session_created=" + session_created);
+    detail_lines.push_back("session_closed=" + session_closed);
+    detail_lines.push_back("prefill_started=" + prefill_started);
+    detail_lines.push_back("prefill_finished=" + prefill_finished);
+    detail_lines.push_back("decode_started=" + decode_started);
+    detail_lines.push_back("decode_finished=" + decode_finished);
+    detail_lines.push_back("raw_output=" + Qairt244FlattenValue(output));
+    detail_lines.push_back("sanitized_output=");
+    detail_lines.push_back("quality_classification=unavailable");
+    detail_lines.push_back("total_ms=" + std::to_string(total_ms));
+    detail_lines.push_back("prefill_ms=" + std::to_string(prefill_ms));
+    detail_lines.push_back("decode_ms=" + std::to_string(decode_ms));
+    detail_lines.push_back("cleanup_ms=" + std::to_string(cleanup_ms));
+    detail_lines.push_back("failure_stage=" +
+                           (run_status == "success" ? std::string("unavailable")
+                                                    : first_failure_stage));
+    detail_lines.push_back("failure_exception_class=" +
+                           (run_status == "success"
+                                ? std::string("unavailable")
+                                : std::string("LiteRtLmJniException")));
+    detail_lines.push_back("failure_exception_message=" +
+                           (run_status == "success"
+                                ? std::string("unavailable")
+                                : Qairt244FlattenValue(run_reason)));
+    detail_lines.push_back("native_diag_tail=" +
+                           Qairt244FlattenValue(native_diag_tail));
+    if (run_status != "success") {
+      break;
+    }
+  }
+
+  engine_close_reached = "true";
+  CloseQairt244PersistentCustomJniHolderLocked(
+      g_qairt244_persistent_custom_jni_holder.invalidated);
+  engine_close_success = "true";
+  if (failure_count == 0) {
+    status = "completed";
+    holder_invalidated = "false";
+    hypothesis_result = "engine_create_once_20_runs_success";
+  } else {
+    holder_invalidated = "true";
+  }
+  write_result();
+  append_stage_diag("END status=" + status +
+                    " completed=" + std::to_string(completed_count) +
+                    " success=" + std::to_string(success_count) +
+                    " failure=" + std::to_string(failure_count) +
+                    " engine_create_count=" +
+                    std::to_string(engine_create_count) +
+                    " decode_success_count=" +
+                    std::to_string(decode_success_count));
+  write_result();
+  return NewStringStandardUTF(env, status);
+}
