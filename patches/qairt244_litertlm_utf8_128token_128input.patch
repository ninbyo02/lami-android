+std::string Qairt244FlattenValue(const std::string& value) {
+  std::string flattened;
+  flattened.reserve(value.size());
+  for (char c : value) {
+    if (c == '\n') {
+      flattened += "\\n";
+    } else if (c == '\r') {
+      flattened += "\\r";
+    } else {
+      flattened.push_back(c);
+    }
+  }
+  return flattened;
+}
+
+void WriteQairt244PersistentProbeResult(
+    const std::string& path, const std::vector<std::string>& lines) {
+  if (path.empty()) {
+    return;
+  }
+  FILE* file = std::fopen(path.c_str(), "w");
+  if (file == nullptr) {
+    return;
+  }
+  for (const std::string& line : lines) {
+    std::fprintf(file, "%s\n", line.c_str());
+  }
+  std::fflush(file);
+  std::fclose(file);
+}
