+};
+
+std::mutex g_qairt244_persistent_custom_jni_mutex;
+Qairt244PersistentCustomJniHolder g_qairt244_persistent_custom_jni_holder;
+
+void CloseQairt244PersistentCustomJniHolderLocked(bool invalidate) {
+  g_qairt244_persistent_custom_jni_holder.engine.reset();
+  g_qairt244_persistent_custom_jni_holder.holder_key.clear();
+  g_qairt244_persistent_custom_jni_holder.invalidated = invalidate;
+}
