+TEST_F(SessionBasicTest, ProcessAndCombineContentsCancelledBeforeVision) {
+  SessionConfig session_config = SessionConfig::CreateDefault();
+  session_config.GetMutableSamplerParams() = sampler_params_;
+  session_config.SetSamplerBackend(Backend::CPU);
+  ASSERT_OK_AND_ASSIGN(auto executor, CreateFakeLlmExecutor({}, {}));
+  testing::StrictMock<MockVisionExecutor> vision;
+  EXPECT_CALL(vision, Encode(testing::A<const litert::TensorBuffer&>())).Times(0);
+  ASSERT_OK_AND_ASSIGN(
+      auto session,
+      SessionBasic::Create(executor.get(), tokenizer_.get(), &vision, nullptr,
+                           session_config, std::nullopt, worker_thread_pool_.get()));
+  ASSERT_OK_AND_ASSIGN(auto image, tokenizer_->TokenIdsToTensorBuffer({90}));
+  std::vector<InputData> inputs;
+  inputs.emplace_back(InputImage(std::move(image)));
+  session->CancelProcess();
+  EXPECT_THAT(session->ProcessAndCombineContents(inputs),
+              StatusIs(absl::StatusCode::kCancelled));
+}
+
+TEST_F(SessionBasicTest, ProcessAndCombineContentsStopsAfterFirstVisionEncode) {
+  SessionConfig session_config = SessionConfig::CreateDefault();
+  session_config.GetMutableSamplerParams() = sampler_params_;
+  session_config.SetSamplerBackend(Backend::CPU);
+  ASSERT_OK_AND_ASSIGN(auto executor, CreateFakeLlmExecutor({}, {}));
+  testing::StrictMock<MockVisionExecutor> vision;
+  ASSERT_OK_AND_ASSIGN(
+      auto session,
+      SessionBasic::Create(executor.get(), tokenizer_.get(), &vision, nullptr,
+                           session_config, std::nullopt, worker_thread_pool_.get()));
+  EXPECT_CALL(vision, Encode(testing::A<const litert::TensorBuffer&>()))
+      .WillOnce(testing::Invoke([&](const litert::TensorBuffer&)
+                                  -> absl::StatusOr<ExecutorVisionData> {
+        session->CancelProcess();
+        return ExecutorVisionData();
+      }));
+  std::vector<InputData> inputs;
+  for (int i = 0; i < 8; ++i) {
+    ASSERT_OK_AND_ASSIGN(auto image, tokenizer_->TokenIdsToTensorBuffer({90}));
+    inputs.emplace_back(InputImage(std::move(image)));
+  }
+  EXPECT_THAT(session->ProcessAndCombineContents(inputs),
+              StatusIs(absl::StatusCode::kCancelled));
+}
