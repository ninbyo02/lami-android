{"id": "question", "category": "prosody", "text": "大丈夫ですか。何か気になることはありますか。", "repeat": 0, "start_kind": "warm", "samples": 174592, "audio_seconds": 3.959002267573696, "pcm_ready_ms": 2322.278018022189, "rtf": 0.5865816337219262, "peak": 0.5948086380958557, "rms": 0.10437497298383862, "reading_input": "ダイジョーブデスカ。ナニカキニナルコトワアリマスカ。", "normalized_text": "ダイジョーブデスカナニカキニナルコトワアリマスカ", "phone_ids": 89, "frontend_ms": 2.0242120081093162, "neural_ms": 2320.2538060140796, "status": "ok", "wav": "question-r0.wav", "wav_sha256": "bf8560671f373db37b7f537659c7d139810adfd7cb37a007da9cee42ab667760", "listening": "pending"}
