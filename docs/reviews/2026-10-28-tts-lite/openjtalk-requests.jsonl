{"id": "punctuation", "category": "punctuation", "text": "ええと……そうですね。もう一度、確認してみます！", "repeat": 0, "start_kind": "warm", "samples": 154112, "audio_seconds": 3.4946031746031747, "pcm_ready_ms": 2050.323659001151, "rtf": 0.5867114394852494, "peak": 0.5816603899002075, "rms": 0.10811124538054694, "reading_input": "エエト……ソーデスネ。モーイチド、カクニンシテミマス！", "normalized_text": "エエトソーデスネモーイチドカクニンシテミマス", "phone_ids": 77, "frontend_ms": 0.6219900096766651, "neural_ms": 2049.7016689914744, "status": "ok", "wav": "punctuation-r0.wav", "wav_sha256": "a9a57769ff75c5c71ac7851275562f408b54e20747c3fdc2c014e5325aa9171c", "listening": "pending"}
