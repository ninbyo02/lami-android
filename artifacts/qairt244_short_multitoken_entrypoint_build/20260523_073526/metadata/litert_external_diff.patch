+             shared_library_dir ? shared_library_dir->c_str() : "<none>",
+             soc_info.has_value());
   if (auto status = qnn_manager->Init(shared_library_dir, soc_info, options);
       status != kLiteRtStatusOk) {
+    QAIRT244_ANDROID_LOG("QnnManager::Create return failure status=%s(%d)",
+                         LiteRtStatusName(status), status);
+    LITERT_LOG(LITERT_ERROR,
+               "QAIRT244_DIAG QnnManager::Create failed status=%d", status);
     return Unexpected(status, "Failed to set up QNN manager");
   }
+  QAIRT244_ANDROID_LOG("QnnManager::Create return success");
+  LITERT_LOG(LITERT_ERROR, "QAIRT244_DIAG QnnManager::Create succeeded");
   return qnn_manager;
 }
