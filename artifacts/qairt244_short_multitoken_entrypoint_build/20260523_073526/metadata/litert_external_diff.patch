+  va_list args;
+  va_start(args, format);
+  std::vfprintf(file, format, args);
+  va_end(args);
+  std::fprintf(file, "\n");
+  std::fflush(file);
+  std::fclose(file);
+}
+
+const char* LiteRtStatusName(LiteRtStatus status) {
+  switch (status) {
