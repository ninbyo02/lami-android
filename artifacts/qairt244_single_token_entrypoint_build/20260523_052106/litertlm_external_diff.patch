+                     kQairt244LowerLevelSingleTokenMarker);
+  auto responses = session_ptr->RunDecode(decode_config);
+  if (!responses.ok()) {
+    const std::string detail =
+        "decode-failed:" + responses.status().ToString();
+    AppendQairt244Diag(diag_path_str.c_str(), "%s %s",
+                       kQairt244LowerLevelSingleTokenMarker, detail.c_str());
+    WriteQairt244SingleTokenResult(result_path_str, "failure", detail, "", 0);
+    ThrowLiteRtLmJniException(env, detail);
+    return nullptr;
+  }
+
+  std::string output;
+  if (!responses->GetTexts().empty()) {
+    output = responses->GetTexts()[0];
+  }
+  const long elapsed_ms =
+      absl::ToInt64Milliseconds(absl::Now() - start_time);
+  AppendQairt244Diag(
+      diag_path_str.c_str(),
+      "%s success output_candidates=%zu output_bytes=%zu elapsed_ms=%ld "
+      "Engine.close=unique_ptr_cleanup",
+      kQairt244LowerLevelSingleTokenMarker, responses->GetTexts().size(),
+      output.size(), elapsed_ms);
+  WriteQairt244SingleTokenResult(result_path_str, "success", "completed",
+                                 output, elapsed_ms);
+  return NewStringStandardUTF(env, output);
+}
